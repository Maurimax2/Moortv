<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Declared, not required.

      Half of what this is installed on is a cheap box running plain Android
      with a launcher over it: a remote, no touchscreen, and no leanback. It is
      a television as far as the customer is concerned, and requiring the
      feature marks the app as unsuitable for the hardware it is mostly sold on.
    -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".MaurimaxTvApplication"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:banner="@drawable/ic_banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MaurimaxTv">

        <activity
            android:name=".TvMainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.MaurimaxTv">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- LEANBACK_LAUNCHER is what puts the app on the Android TV home row. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <!--
                  And LAUNCHER is what puts it anywhere else.

                  A box without a leanback launcher has no home row to be on, so
                  with only the category above the app installed cleanly and then
                  had no icon at all — nothing to press, on hardware where there
                  is no app drawer to go looking in either. Declaring both is
                  harmless on a real Android TV, which reads the leanback entry.
                -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
